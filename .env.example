# Copy this file to .env and fill in your Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here
# Optional: extra keys, comma separated. Used in rotation, skipping keys that hit rate limits.
GEMINI_API_KEYS=
# Jobs per Gemini request (free tier counts requests per day, so bigger = fewer requests)
GEMINI_BATCH_SIZE=40
GEMINI_MODEL=gemini-3.5-flash

# Telegram notifications (create a bot with @BotFather). Anyone who messages the bot registers by sending a CV.
TELEGRAM_BOT_TOKEN=
# Your own chat id (run: python -m backend.notifier chat-id). Your CV is the web app's CV.
TELEGRAM_CHAT_ID=
# New Gemini scorings per user per run (a new user's first list is spread over several runs)
SCORE_LIMIT_PER_USER=200
# Daily list shows open jobs Gemini scored at or above this
NOTIFY_MIN_SCORE=70
# Jobs without a deadline (LinkedIn/Remotive) are dropped after not being seen for this many days
STALE_DAYS=7

# Automatic runs: daily times (HH:MM, 24h) in TZ. Leave empty to disable.
TZ=Asia/Dhaka
SCHEDULE_TIMES=09:00
SCHEDULE_SOURCES=bdjobs,linkedin,remotive
SCHEDULE_FRESHER=true
# false = all open jobs with their real deadlines (true = only jobs closing today)
SCHEDULE_DEADLINE_TODAY=false
