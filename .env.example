# Copy this file to .env and fill in your Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Telegram notifications (create a bot with @BotFather, then run: python -m backend.notifier chat-id)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Only send jobs Gemini scored at or above this
NOTIFY_MIN_SCORE=70

# Automatic runs: daily times (HH:MM, 24h) in TZ. Leave empty to disable.
TZ=Asia/Dhaka
SCHEDULE_TIMES=09:00,14:00,20:00
SCHEDULE_SOURCES=bdjobs,linkedin,remotive
SCHEDULE_FRESHER=true
SCHEDULE_DEADLINE_TODAY=true
